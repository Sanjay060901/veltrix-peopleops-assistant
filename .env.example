# Copy to .env and fill in the API key. docker compose reads .env automatically.

# Inputs (paths are relative to the repo root locally and to /app inside the container)
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date as YYYY-MM-DD. Empty means the system date.
APP_TODAY=

# LLM
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=10

# Retrieval: local CPU embeddings (fastembed) fused with BM25; "none" = BM25 only
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=

# Rules and limits
CORPUS_TOKEN_BUDGET=3000
LEAVE_YEAR=2026
HISTORY_TURNS=6
# Seconds between checks for changed corpus/manifest files (0 = only ingest at startup)
CORPUS_RELOAD_SECONDS=30
# Parsed chunks, holidays and embeddings cached by file SHA-256 (empty = no cache)
CACHE_DIR=./.cache/ingest
LOG_LEVEL=INFO
